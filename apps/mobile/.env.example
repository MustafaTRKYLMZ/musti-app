# Backend (Budget sync)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# Google Calendar (Planner)
# Create OAuth clients in Google Cloud Console → APIs & Services → Credentials
# Enable "Google Calendar API" for the project.
# Android client: enable "Custom URI scheme" in the client settings (required for dev builds).
# Web client (used by expo-auth-session; do NOT use for token refresh in-app)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Token refresh uses iOS/Android client IDs below (no client_secret)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# Android client: package com.musti.app, EAS SHA-1, enable Custom URI scheme
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

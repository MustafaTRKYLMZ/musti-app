{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,

    "module": "ESNext",
    "target": "ES2019",
    "moduleResolution": "Bundler",

    "emitDeclarationOnly": false,
    "jsx": "react-jsx",

    "skipLibCheck": true
  },
  "include": ["src"]
}

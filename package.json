{
  "name": "musti-app",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "dev:mobile": "npm run start --workspace mobile",
    "lint:web": "npm run lint --workspace web",
    "lint:mobile": "eslint apps/mobile",
    "build:core": "pnpm --filter @musti/core build",
    "eas-build-post-install": "pnpm build:core",
    "i18n:watch": "node packages/core/scripts/watch-translations.js",
    "i18n:export": "node packages/core/scripts/export-translations.js",
    "android:bundle": "cd apps/mobile/android && ./gradlew :app:bundleRelease",
    "apk": "cd apps/mobile/android && ./gradlew :app:assembleRelease && open app/build/outputs/apk/release",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "overrides": {
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "react-native-gesture-handler": "~2.28.0"
  },
  "devDependencies": {
    "@types/babel__template": "^7.4.4",
    "@types/jest": "^30.0.0",
    "@types/react-native": "^0.72.8",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.25",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.20",
    "expo-notifications": "~0.32.15",
    "expo-sharing": "~14.0.8",
    "nanoid": "^5.1.6",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
